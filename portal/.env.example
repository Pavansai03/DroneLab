# =====================================================================
# DroneLab portal — Next.js environment
# =====================================================================
# Copy to portal/.env.local and fill in.
#
# NEXT_PUBLIC_ variables are inlined into the browser bundle at build time
# and are readable by anyone. Only ever put public values here. The service
# role key belongs in server/.env and nowhere else.

# Supabase project URL. Self-hosted: the Kong gateway URL, port 8000.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.your-domain.example

# The ANON key. Public by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-jwt

# Where the Express API is reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where the flight simulator is served. Local dev is the Vite app on 5173;
# in production this is wherever the simulator is deployed.
NEXT_PUBLIC_SIMULATOR_URL=http://localhost:5173
