# =====================================================================
# DroneLab API — server environment
# =====================================================================
# Copy to server/.env and fill in. This file is the ONLY place the service
# role key belongs. It must never appear in the Next.js portal, the Vite
# simulator, or any variable prefixed NEXT_PUBLIC_ or VITE_.

# Supabase project URL. Self-hosted: the Kong gateway URL, port 8000.
SUPABASE_URL=https://supabase.your-domain.example

# The ANON key. Public by design — it is what the browser uses, and it is
# only safe because Row Level Security is enabled on every table.
SUPABASE_ANON_KEY=your-anon-key-jwt

# The SERVICE ROLE key. Bypasses RLS completely. Treat it like a database
# password: server-side only, never committed, rotated if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-jwt

# Which origins may call this API. Comma-separated, no wildcards.
CORS_ORIGINS=http://localhost:3000

PORT=4000

# --------------------------------------------------------------------
# Email. Optional: approving a school still works without it, and the
# join code is shown in the admin panel so it can be passed on by hand.
# Coupling approval to SMTP would mean one mail outage blocks every
# approval, which is worse than an email that has to be sent manually.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=DroneLab <you@example.com>

# Where the portal lives. Used in the links inside approval emails.
PORTAL_URL=http://localhost:3000
