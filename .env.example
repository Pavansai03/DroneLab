# =====================================================================
# DroneLab — optional Supabase configuration
# =====================================================================
# Copy to `.env.local` for local development. Both may be omitted: the app
# then runs fully offline with the cloud layer switched off.
#
# On Dokploy these must be BUILD ARGUMENTS, not runtime environment
# variables — Vite bakes them into the bundle during `vite build`.
#
# The Kong gateway URL, i.e. the domain you pointed at the Supabase
# template's Kong service on port 8000. Use https in production: an http
# URL loaded from an https page is blocked by the browser as mixed content.
VITE_SUPABASE_URL=https://supabase.your-domain.example

# The ANON key. This is public by design and safe to ship in the bundle
# ONLY because Row Level Security is enabled on every table by
# supabase/schema.sql. Verify RLS is on before real student data goes in.
#
# NEVER put SERVICE_ROLE_KEY here. It bypasses RLS completely.
VITE_SUPABASE_ANON_KEY=your-anon-key-jwt

# Where the portal lives. Set this and the simulator shows a back arrow to it;
# leave it unset and the simulator runs standalone with no back control.
VITE_PORTAL_URL=http://localhost:3000
